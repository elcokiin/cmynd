---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ForceField404 } from "../components/react/ForceField404";
import { Atmosphere } from "@elcokiin/ui/atmosphere";

import "../styles/global.css";
---

<BaseLayout title="Not Found · elcokiin blog" description="Page not found" canonicalPath="/404">
    <ForceField404 client:load
      className="ff-404 relative flex flex-col items-center justify-center min-h-[96vh] w-full overflow-hidden"
    shape="hexagon"
    opacity={0.8}
    cellScale={18}
    lineWidth={0.035}
    gridOpacity={0.12}
    gridReveal="click"
    gridRevealStrength={1.4}
    gridRevealRadius={300}
    gridFade={0.35}
    flashSpeed={0.8}
    flashIntensity={0.02}
    flowScale={4}
    flowSpeed={0.15}
    flowIntensity={0.15}
    edgeGlow={0.15}
    edgeFalloff={0.22}
    rippleSpeed={0.6}
    rippleWidth={0.05}
    rippleBlend={1}
    rippleDuration={1.6}
    rippleIntensity={0.14}
    rippleMaxRadius={0.9}
    impactRadius={0.16}
    refraction={25}
    aberration={2}
    haze={0.3}
    tint={0.08}
    hoverGlow={0.3}
    hoverRadius={360}
    hoverCharge={1.8}
    bloom={1.1}
    grain={0.12}
  >
  <Atmosphere client:load transparent className="relative z-0 min-h-[96vh] flex items-center">
      <div class="mx-auto flex w-full max-w-2xl flex-col items-center justify-center text-center">
      <h1 class="not-found-title">Post no encontrado</h1>

      <blockquote class="not-found-quote">
        <p>Esta página se ha perdido más allá de las estrellas.</p>
        <p>Tal vez nunca fue escrita, o se desvaneció en el vacío.</p>
      </blockquote>

      <a href="/" data-astro-prefetch class="go-home-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Volver al inicio
      </a>

      </div>
  </Atmosphere>
    </ForceField>
</BaseLayout>

<style>
  .ff-404 > canvas > div,
  .ff-404 > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden !important;
  }

  .not-found-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: var(--text);
    letter-spacing: -0.01em;
    animation: fadeInUp 0.8s ease-out both;
  }

  .not-found-quote {
    position: relative;
    margin: 0 0 2.5rem;
    padding: 2rem 2.5rem;
    border-left: 3px solid var(--primary-aquamarine);
    border-radius: 0 14px 14px 0;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    text-align: left;
  }

  .not-found-quote::before {
    content: '\201C';
    position: absolute;
    top: -0.4rem;
    left: 0.8rem;
    font-family: "Playfair Display", serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--primary-aquamarine);
    opacity: 0.2;
    pointer-events: none;
  }

  .not-found-quote p {
    margin: 0;
    font-family: "Playfair Display", serif;
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    font-style: italic;
    line-height: 1.7;
    color: var(--text);
  }

  .not-found-quote p + p {
    margin-top: 0.5rem;
  }

  .go-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-family: "Merriweather", serif;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary-blue);
    background: var(--primary-aquamarine);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 0 16px color-mix(in srgb, var(--primary-aquamarine) 25%, transparent);
  }

  .go-home-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px color-mix(in srgb, var(--primary-aquamarine) 40%, transparent);
  }

  .go-home-btn svg {
    flex-shrink: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  html[data-theme="light"] .go-home-btn {
    background: var(--accent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  html[data-theme="light"] .go-home-btn:hover {
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  html[data-theme="light"] .not-found-quote::before {
    color: var(--accent);
  }

  html[data-theme="light"] .not-found-quote {
    border-left-color: var(--accent);
  }
</style>
