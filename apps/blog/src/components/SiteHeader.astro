---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<header 
  id="site-header" 
  class="z-10 fixed top-0 flex items-center justify-between p-2 w-full sm:p-4 md:px-20 border-b border-transparent transition-all duration-255"
  style="background: var(--header-bg); color: var(--header-text);"
>
  <div class="flex items-center w-32 justify-between sm:w-40">
    <a href="/" data-astro-prefetch>
      <figure class="w-14 h-14 rounded-full object-cover sm:w-20 sm:h-20 lg:w-14 lg:h-14">
        <Image src={logo} alt="elcokiin logo" class="object-cover rounded-full w-full h-full" />
      </figure>
    </a>
    <a href="/" class="font-bold sm:text-2xl" data-astro-prefetch style="color: var(--header-text);">
      Inicio
    </a>
  </div>

  <div class="flex items-center gap-4">
    <a 
      href="https://elcokiin.my" 
      target="_blank"
      rel="noopener noreferrer"
      id="header-author-name" 
      class="animated-underline font-bold text-xl opacity-0 pointer-events-none transition-opacity duration-300 hidden sm:block"
      style="color: var(--header-text); --underline-height: 2px; --underline-bottom: -2px;"
    >
      Diego Tenjo
    </a>
    <div class="hidden sm:flex justify-center items-center gap-4">
      {/* TODO: Add ToogleTheme and ToogleLanguage components when available */}
    </div>
    {/* Mobile Menu Button */}
    <button class="w-8 h-8 sm:hidden flex items-center justify-center" aria-label="Menu" id="mobile-menu-btn" style="color: var(--header-text);">
      <svg id="hamburger-icon" stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="26" width="26" xmlns="http://www.w3.org/2000/svg">
        <path d="M32 96v64h448V96H32zm0 128v64h448v-64H32zm0 128v64h448v-64H32z"></path>
      </svg>
    </button>
  </div>
</header>

{/* Mobile Drawer Overlay */}
<div id="mobile-drawer-overlay" class="mobile-drawer-overlay"></div>

{/* Mobile Drawer */}
<aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer-header">
    <span class="mobile-drawer-title" style="color: var(--text);">Menu</span>
    <button id="mobile-drawer-close" class="mobile-drawer-close" aria-label="Close menu" style="color: var(--text);">
      <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="22" width="22" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="mobile-drawer-nav">
    <a href="/" class="mobile-drawer-link" data-astro-prefetch>
      <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z"></path>
      </svg>
      Inicio
    </a>
    <a href="https://elcokiin.my" target="_blank" rel="noopener noreferrer" class="mobile-drawer-link">
      <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      Diego Tenjo
    </a>
  </nav>

  <div class="mobile-drawer-divider" style="border-color: var(--border);"></div>

  <div class="mobile-drawer-section">
    <span class="mobile-drawer-section-label" style="color: var(--cool-gray);">Appearance</span>
    <button id="mobile-theme-toggle" class="mobile-theme-toggle" aria-label="Toggle theme">
      <svg id="theme-icon-sun" stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg" style="display:none;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
      </svg>
      <svg id="theme-icon-moon" stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg" style="display:none;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
      <span id="theme-label" style="color: var(--text);">Dark</span>
      <span class="mobile-theme-toggle-hint" style="color: var(--cool-gray);">D</span>
    </button>
  </div>
</aside>

<script>
  function applyThemeLocal(t: "dark" | "light") {
    document.documentElement.setAttribute("data-theme", t);
    document.documentElement.classList.toggle("dark", t === "dark");
    localStorage.setItem("theme", t);
  }

  function syncThemeUI() {
    const current = (localStorage.getItem("theme") || "dark") as "dark" | "light";
    const sun = document.getElementById("theme-icon-sun");
    const moon = document.getElementById("theme-icon-moon");
    const label = document.getElementById("theme-label");
    if (sun && moon && label) {
      sun.style.display = current === "light" ? "block" : "none";
      moon.style.display = current === "dark" ? "block" : "none";
      label.textContent = current === "dark" ? "Dark" : "Light";
    }
  }

  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-drawer");
    const overlay = document.getElementById("mobile-drawer-overlay");
    const closeBtn = document.getElementById("mobile-drawer-close");
    const themeToggle = document.getElementById("mobile-theme-toggle");

    if (!btn || !drawer || !overlay || !closeBtn) return;

    function openDrawer() {
      drawer!.classList.add("is-open");
      overlay!.classList.add("is-open");
      btn!.setAttribute("aria-expanded", "true");
      drawer!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      syncThemeUI();
    }

    function closeDrawer() {
      drawer!.classList.remove("is-open");
      overlay!.classList.remove("is-open");
      btn!.setAttribute("aria-expanded", "false");
      drawer!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    btn.addEventListener("click", () => {
      const isOpen = drawer!.classList.contains("is-open");
      isOpen ? closeDrawer() : openDrawer();
    });

    closeBtn.addEventListener("click", closeDrawer);
    overlay.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer!.classList.contains("is-open")) {
        closeDrawer();
      }
    });

    if (themeToggle) {
      themeToggle.addEventListener("click", () => {
        const current = (localStorage.getItem("theme") || "dark") as "dark" | "light";
        const next = current === "dark" ? "light" : "dark";
        applyThemeLocal(next);
        syncThemeUI();
      });
    }
  }

  function setupHeaderScroll() {
    const header = document.getElementById('site-header');
    
    const handleScroll = () => {
      if (!header) return;
      
      const scrolled = window.scrollY;
      const threshold = window.innerHeight * 0.4;
      
      if (scrolled > threshold) {
        header.classList.add('backdrop-blur-md', 'border-gray-700');
        header.style.background = `color-mix(in srgb, var(--header-bg) 80%, transparent)`;
        header.classList.remove('border-transparent');
      } else {
        header.classList.remove('backdrop-blur-md');
        header.style.background = 'var(--header-bg)';
        header.classList.add('border-transparent');
      }
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll();
  }

  setupMobileMenu();
  setupHeaderScroll();
  document.addEventListener('astro:page-load', () => {
    setupMobileMenu();
    setupHeaderScroll();
  });
</script>
