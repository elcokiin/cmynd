---
import { Logo } from '@elcokiin/ui/logo';
import { Atmosphere } from '@elcokiin/ui/atmosphere';
import logo from '../assets/logo.png';

const isHome = Astro.url.pathname === "/";
---

<header 
  id="site-header" 
  class="z-50 fixed top-0 flex items-center justify-between p-2 w-full sm:p-4 md:px-20 border-b border-transparent transition-all duration-255"
  style="color: var(--header-text);"
>
  <Atmosphere client:load transparent className="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute inset-0" />
  </Atmosphere>

  <div class="flex items-center w-32 justify-between sm:w-40 relative z-10">
    <a href="/" data-astro-prefetch>
      <figure class="w-14 h-14 sm:w-20 sm:h-20 lg:w-14 lg:h-14">
        <Logo src={logo.src} alt="elcokiin logo" className="w-full h-full" client:load />
      </figure>
    </a>
  </div>

  <div id="header-theme-wrap" class="flex items-center gap-4 relative z-10" data-theme-reveal={isHome ? "true" : "false"}>
    <button
      id="header-theme-toggle"
      class="header-theme-toggle"
      aria-label="Cambiar tema"
      title="Cambiar tema"
    >
      <svg id="header-theme-sun" class="header-theme-icon" stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="18" width="18" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
      </svg>
      <svg id="header-theme-moon" class="header-theme-icon is-hidden" stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="18" width="18" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
    </button>
    <script is:inline>
      (() => {
        const isLight =
          document.documentElement.getAttribute("data-theme") === "light";
        document
          .getElementById("header-theme-sun")
          ?.classList.toggle("is-hidden", !isLight);
        document
          .getElementById("header-theme-moon")
          ?.classList.toggle("is-hidden", isLight);
      })();
    </script>
    {isHome && (
      <a
        href="https://elcokiin.me"
        target="_blank"
        rel="noopener noreferrer"
        id="header-author-name"
        class="animated-underline text-base opacity-0 pointer-events-none hidden sm:block"
        style="color: var(--header-text); --underline-height: 2px; --underline-bottom: -2px;"
      >
        Diego Tenjo
      </a>
    )}
  </div>
</header>

{/* Mobile Drawer Overlay */}
<div id="mobile-drawer-overlay" class="mobile-drawer-overlay"></div>

{/* Mobile Drawer */}
<aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer-header">
    <span class="mobile-drawer-title" style="color: var(--text);">Menú</span>
    <button id="mobile-drawer-close" class="mobile-drawer-close" aria-label="Cerrar menú" style="color: var(--text);">
      <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="22" width="22" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="mobile-drawer-nav">
    <a href="https://elcokiin.me" target="_blank" rel="noopener noreferrer" class="mobile-drawer-link">
      <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      Diego Tenjo
    </a>
  </nav>

  <div class="mobile-drawer-divider" style="border-color: var(--border);"></div>

  <div class="mobile-drawer-section">
    <span class="mobile-drawer-section-label" style="color: var(--cool-gray);">Apariencia</span>
    <div class="mobile-theme-options">
      <button id="theme-light-btn" class="mobile-theme-option" data-theme-value="light" aria-label="Tema claro">
        <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <span>Claro</span>
      </button>
      <button id="theme-dark-btn" class="mobile-theme-option" data-theme-value="dark" aria-label="Tema oscuro">
        <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <span>Oscuro</span>
      </button>
    </div>
  </div>
</aside>

{/* Mobile FAB — thumb-friendly bottom-right */}
<button
  id="mobile-menu-btn"
  class="mobile-fab sm:hidden"
  aria-label="Abrir menú"
>
  <svg id="hamburger-icon" stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" height="22" width="22" xmlns="http://www.w3.org/2000/svg">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <svg id="close-icon" class="hidden" stroke="currentColor" fill="none" stroke-width="2.5" viewBox="0 0 24 24" height="22" width="22" xmlns="http://www.w3.org/2000/svg">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
  </svg>
</button>

<script>
  import gsap from 'gsap';
  import { applyTheme, getTheme, toggleTheme } from "../lib/theme";

  let revealCtx: gsap.Context | null = null;

  function syncThemeUI() {
    const current = getTheme();
    const lightBtn = document.getElementById("theme-light-btn");
    const darkBtn = document.getElementById("theme-dark-btn");
    if (lightBtn && darkBtn) {
      lightBtn.classList.toggle("is-active", current === "light");
      darkBtn.classList.toggle("is-active", current === "dark");
    }
    const sun = document.getElementById("header-theme-sun");
    const moon = document.getElementById("header-theme-moon");
    if (sun && moon) {
      sun.classList.toggle("is-hidden", current === "dark");
      moon.classList.toggle("is-hidden", current === "light");
    }
  }

  function setupThemeButtons() {
    const lightBtn = document.getElementById("theme-light-btn");
    const darkBtn = document.getElementById("theme-dark-btn");
    if (lightBtn) {
      lightBtn.addEventListener("click", () => {
        applyTheme("light");
        syncThemeUI();
      });
    }
    if (darkBtn) {
      darkBtn.addEventListener("click", () => {
        applyTheme("dark");
        syncThemeUI();
      });
    }
    const headerToggle = document.getElementById("header-theme-toggle");
    if (headerToggle) {
      headerToggle.addEventListener("click", () => {
        toggleTheme();
        syncThemeUI();
      });
    }
  }

  function setupThemeToggleReveal() {
    const wrap = document.getElementById("header-theme-wrap");
    if (!wrap || wrap.dataset.themeReveal !== "true") return;

    const button = document.getElementById("header-theme-toggle");
    const link = document.getElementById("header-author-name");
    const header = document.getElementById("site-header");
    if (!button || !link || !header) return;

    revealCtx?.revert();
    revealCtx = gsap.context(() => {
      const mm = gsap.matchMedia();

      mm.add("(min-width: 640px)", () => {
        let visible = false;

        const shift = () => {
          const gap = parseFloat(getComputedStyle(wrap).gap) || 16;
          return (link.offsetWidth || 0) + gap;
        };

        const apply = () => {
          const s = shift();
          const tl = gsap.timeline({ overwrite: "auto" });
          if (visible) {
            tl.to(button, { x: -s, duration: 0.3, ease: "power2.out" }, 0).to(
              link,
              { opacity: 1, pointerEvents: "auto", duration: 0.25, ease: "power2.out" },
              0.15,
            );
          } else {
            tl.to(
              link,
              { opacity: 0, pointerEvents: "none", duration: 0.15, ease: "power2.out" },
              0,
            ).to(button, { x: 0, duration: 0.3, ease: "power2.out" }, 0.1);
          }
        };

        const update = () => {
          const next = window.scrollY >= window.innerHeight * 0.18;
          if (next !== visible) {
            visible = next;
            apply();
          }
        };

        gsap.set(button, { x: 0 });
        gsap.set(link, { opacity: 0, pointerEvents: "none" });

        window.addEventListener("resize", update);
        window.addEventListener("scroll", update, { passive: true });
        update();

        return () => {
          window.removeEventListener("scroll", update);
          window.removeEventListener("resize", update);
          button.style.transform = "";
          link.style.opacity = "";
          link.style.pointerEvents = "";
        };
      });
    }, header);
  }

  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-drawer");
    const overlay = document.getElementById("mobile-drawer-overlay");
    const closeBtn = document.getElementById("mobile-drawer-close");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (!btn || !drawer || !overlay || !closeBtn) return;

    function openDrawer() {
      drawer!.classList.add("is-open");
      overlay!.classList.add("is-open");
      btn!.setAttribute("aria-expanded", "true");
      btn!.setAttribute("aria-label", "Cerrar menú");
      drawer!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      hamburgerIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      syncThemeUI();
    }

    function closeDrawer() {
      drawer!.classList.remove("is-open");
      overlay!.classList.remove("is-open");
      btn!.setAttribute("aria-expanded", "false");
      btn!.setAttribute("aria-label", "Abrir menú");
      drawer!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }

    btn.addEventListener("click", () => {
      const isOpen = drawer!.classList.contains("is-open");
      isOpen ? closeDrawer() : openDrawer();
    });

    closeBtn.addEventListener("click", closeDrawer);
    overlay.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer!.classList.contains("is-open")) {
        closeDrawer();
      }
    });
  }

  function setupHeaderBg() {
    const header = document.getElementById("site-header");
    if (!header) return;

    let frame = 0;
    const update = () => {
      frame = 0;
      const scrolled = window.scrollY >= window.innerHeight * 0.1;
      header.classList.toggle("is-scrolled", scrolled);
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }

  setupMobileMenu();
  setupThemeButtons();
  setupThemeToggleReveal();
  setupHeaderBg();
  document.addEventListener('astro:page-load', () => {
    setupMobileMenu();
    setupThemeButtons();
    setupThemeToggleReveal();
    setupHeaderBg();
  });
</script>

<style>
  #site-header {
    background: transparent;
  }

  #site-header.is-scrolled {
    background: color-mix(in srgb, var(--header-bg) 80%, transparent);
  }

  .header-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.75rem;
    border: none;
    background: color-mix(in srgb, var(--header-bg) 60%, transparent);
    color: var(--header-text);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .header-theme-toggle:hover {
    color: var(--accent);
    transform: scale(1.05);
  }

  .header-theme-toggle:active {
    transform: scale(0.95);
  }

  .header-theme-toggle .is-hidden {
    display: none;
  }

  #header-theme-wrap[data-theme-reveal="true"] #header-author-name {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    #header-author-name {
      display: none !important;
    }
  }
</style>
