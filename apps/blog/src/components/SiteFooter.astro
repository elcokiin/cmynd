---

<footer
  class="relative mt-20 w-full overflow-hidden border-t"
  style="background: var(--footer-bg); border-top-color: var(--border);"
>
  {/*
    Atmosphere provides the starry night sky behind the frost: a cursor
    stardust trail plus click starbursts, softly frosted by the overlay.
  */}
  <Atmosphere client:load transparent className="relative z-0">
    <FrostFooter
      client:load
    className="relative z-10 w-full min-h-[520px] md:min-h-[600px]"
    frost={0.08}
    strength={0.7}
    contrast={3}
    crispness={1}
    highlight={0.35}
    haze={0.35}
    tintStrength={0.35}
    refraction={1}
    detail={2}
    textureScale={2}
    meltRadius={0.16}
    meltNoise={0.38}
    meltStrength={0.8}
    refreeze={2.2}
    opacity={0.3}
    shimmer={0}
    meltEdges
  >
    <div
      class="mx-auto flex min-h-full w-full max-w-6xl flex-col justify-center gap-14 px-6 py-20 md:gap-16 md:px-10 md:py-24"
    >
      <div class="grid grid-cols-1 items-center gap-16 md:grid-cols-3 md:gap-12">
        {/* Brand */}
        <div class="text-center md:text-left">
          <p class="text-sm font-semibold tracking-[0.25em]" style="color: var(--accent);">
            @elcokiin
          </p>
          <p
            class="mt-3 text-2xl font-bold tracking-tight md:text-3xl"
            style="color: var(--footer-text);"
          >
            <a
              href="https://elcokiin.my"
              target="_blank"
              rel="noopener noreferrer"
              class="animated-underline"
            >
              Diego Tenjo
            </a>
          </p>
          <p
            class="mx-auto mt-4 max-w-xs text-base leading-relaxed md:mx-0"
            style="color: var(--footer-muted);"
          >
            {texts.subtitle}
          </p>
          <p
            class="mt-6 inline-block rounded-full px-5 py-2 text-sm italic backdrop-blur-sm"
            style="
              color: var(--accent);
              background: color-mix(in srgb, var(--accent) 12%, transparent);
              border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
            "
          >
            "{texts.tagline}"
          </p>
        </div>

        {/* Social Links */}
        <div class="flex flex-col items-center gap-5">
          
          <div class="flex items-center gap-5 md:gap-6">
            {socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                title={social.label}
                aria-label={social.label}
                class="group flex h-16 w-16 items-center justify-center rounded-3xl border transition-colors duration-300 md:h-[72px] md:w-[72px]"
                style="
                  color: var(--footer-text);
                  background: color-mix(in srgb, var(--footer-text) 7%, transparent);
                  border-color: color-mix(in srgb, var(--primary-aquamarine) 40%, transparent);
                "
              >
                <svg
                  stroke="currentColor"
                  fill="currentColor"
                  stroke-width="0"
                  viewBox={social.viewBox}
                  class="h-7 w-7 transition-colors duration-300 group-hover:text-[color:var(--accent)] md:h-8 md:w-8"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d={social.path}></path>
                </svg>
              </a>
            ))}
          </div>
        </div>

        {/* Meta */}
        <div class="flex flex-col items-center gap-5 md:items-end">
          <p class="text-sm font-semibold uppercase tracking-[0.25em]" style="color: var(--footer-muted);">
            Última actualización
          </p>
          <p class="text-2xl font-bold md:text-3xl" style="color: var(--footer-text);">
            {lastUpdateDate || year}
          </p>
        </div>
      </div>

      {/* Bottom bar */}
      <div
        class="flex flex-col items-center justify-center gap-3 border-t pt-8 text-center text-sm md:flex-row"
        style="border-color: var(--border); color: var(--footer-muted);"
      >
        <p>© {year} Diego Tenjo — @elcokiin</p>
      </div>
    </div>
    </FrostFooter>
  </Atmosphere>
</footer>
